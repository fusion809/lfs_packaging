<?xml version="1.0"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="chemical/x-cif">
    <comment>Crystallographic Information File</comment>
    <glob pattern="*.cif"/>
  </mime-type>
  <mime-type type="chemical/x-cml">
    <comment>Chemical Markup Language</comment>
    <glob pattern="*.cml"/>
  </mime-type>
  <mime-type type="chemical/x-daylight-smiles">
    <comment>SMILES chemical structure</comment>
    <glob pattern="*.smi"/>
    <glob pattern="*.smiles"/>
  </mime-type>
  <mime-type type="chemical/x-inchi">
    <comment>InChI chemical structure</comment>
    <glob pattern="*.inchi"/>
  </mime-type>
  <mime-type type="chemical/x-mdl-molfile">
    <comment>MDL Molfile</comment>
    <glob pattern="*.mol"/>
    <glob pattern="*.mdl"/>
  </mime-type>
  <mime-type type="chemical/x-mdl-rdfile">
    <comment>MDL RDfile</comment>
    <glob pattern="*.rdf"/>
  </mime-type>
  <mime-type type="chemical/x-mdl-rxnfile">
    <comment>MDL RXNfile</comment>
    <glob pattern="*.rxn"/>
  </mime-type>
  <mime-type type="chemical/x-mdl-sdfile">
    <comment>MDL SDfile</comment>
    <glob pattern="*.sdf"/>
    <glob pattern="*.sd"/>
  </mime-type>
  <mime-type type="chemical/x-mmcif">
    <comment>Macromolecular Crystallographic Information File</comment>
    <glob pattern="*.mmcif"/>
    <glob pattern="*.mcif"/>
  </mime-type>
  <mime-type type="chemical/x-mol2">
    <comment>Sybyl MOL2 file</comment>
    <glob pattern="*.mol2"/>
  </mime-type>
  <mime-type type="chemical/x-pdb">
    <comment>Protein Data Bank file</comment>
    <glob pattern="*.pdb"/>
    <glob pattern="*.ent"/>
  </mime-type>
  <mime-type type="chemical/x-xyz">
    <comment>XYZ chemical structure</comment>
    <glob pattern="*.xyz"/>
  </mime-type>
</mime-info>
